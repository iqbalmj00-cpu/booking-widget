{
    "name": "@syj/booking-widget",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "./node_modules/.bin/vite",
        "build": "node scripts/build.mjs",
        "preview": "./node_modules/.bin/vite preview",
        "release": "npm run build && node scripts/release.mjs",
        "check:sync": "node scripts/check-dist-sync.mjs",
        "test": "node ./scripts/run-tests.mjs",
        "test:booking": "node ./tests/booking-regressions.cjs",
        "check:build": "node scripts/check-dist-sync.mjs --local",
        "check:publisher": "node scripts/check-dist-sync.mjs --publisher",
        "test:rental": "node tests/rental-pricing.cjs",
        "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
        "test:provenance": "node --test tests/build-provenance.test.mjs",
        "predev": "npm run check:node",
        "prebuild": "npm run check:node",
        "pretest": "npm run check:node",
        "check:node": "node scripts/check-node-version.mjs",
        "test:build-failure": "node tests/build-failure.mjs",
        "test:publisher": "node --test tests/publisher-blobs.test.mjs",
        "test:build-inputs": "node tests/build-inputs.mjs"
    },
    "dependencies": {
        "lucide-react": "^0.474.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "@stripe/stripe-js": "^8.11.0"
    },
    "devDependencies": {
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "typescript": "^5.7.0",
        "vite": "^6.4.3"
    },
    "engines": {
        "node": "24.x"
    },
    "packageManager": "npm@11.19.0"
}
